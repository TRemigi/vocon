#!/usr/bin/env bash
# Sudo-style unlock for vocon's assistant mode. Runs inside a small terminal that vocon opens: sudo itself
# asks for your password, so the password never reaches vocon. This writes exactly one word to <result-file>:
#   ok | failed | cancelled | timeout | nopassword
# Usage: vocon-unlock <result-file> <seconds>     (not meant to be run by hand)
set -u
umask 077

out="${1:-}"
secs="${2:-60}"
# The path comes from vocon (a private file under $XDG_RUNTIME_DIR); refuse anything odd.
[[ "$out" =~ ^/[A-Za-z0-9_./-]+$ ]] || { echo "vocon-unlock: bad result path" >&2; exit 2; }
[[ "$secs" =~ ^[0-9]{1,3}$ ]] || { echo "vocon-unlock: bad timeout" >&2; exit 2; }

# Write the result atomically, so a reader never sees half a word.
finish() {
  printf '%s\n' "$1" > "$out.tmp" && mv -f "$out.tmp" "$out"
  exit 0
}
trap 'finish cancelled' HUP INT TERM

# A sudo that never asks for a password (NOPASSWD) proves nothing about who is typing: fail closed.
if sudo -n -k -v 2>/dev/null; then finish nopassword; fi

echo "vocon assistant: enter your password to unlock it (Ctrl+C cancels)"
# -k: ignore and do not update sudo's cached credentials, so this unlocks vocon and nothing else.
timeout --foreground "$secs" sudo -k -v -p "password for %u: "
case $? in
  0)       finish ok ;;
  124)     finish timeout ;;
  130|143) finish cancelled ;;
  *)       finish failed ;;
esac
