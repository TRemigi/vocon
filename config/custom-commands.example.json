{
  "commands": [
    {
      "say": "lock screen",
      "exec": [
        "omarchy-system-lock"
      ]
    },
    {
      "say": "night light",
      "exec": [
        "omarchy-toggle-nightlight"
      ]
    },
    {
      "say": "screenshot",
      "exec": [
        "omarchy-capture-screenshot"
      ]
    },
    {
      "say": "screensaver",
      "exec": [
        "omarchy-launch-screensaver"
      ]
    },
    {
      "say": "next background",
      "exec": [
        "omarchy-theme-bg-next"
      ]
    },
    {
      "say": "volume up",
      "exec": [
        "wpctl",
        "set-volume",
        "-l",
        "1.0",
        "@DEFAULT_AUDIO_SINK@",
        "5%+"
      ]
    },
    {
      "say": "volume down",
      "exec": [
        "wpctl",
        "set-volume",
        "@DEFAULT_AUDIO_SINK@",
        "5%-"
      ]
    },
    {
      "say": "volume mute",
      "exec": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SINK@",
        "toggle"
      ]
    },
    {
      "say": "brightness up",
      "exec": [
        "brightnessctl",
        "set",
        "10%+"
      ]
    },
    {
      "say": "brightness down",
      "exec": [
        "brightnessctl",
        "set",
        "10%-"
      ]
    },
    {
      "say": "new terminal",
      "launch": [
        "xdg-terminal-exec"
      ]
    },
    {
      "say": "notes",
      "launch": [
        "obsidian"
      ]
    },
    {
      "say": "focus mode",
      "exec": [
        "omarchy-toggle-notification-silencing"
      ]
    },
    {
      "say": "next",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-k",
        "Tab",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^(chromium|firefox|brave-browser|google-chrome)$"
      }
    },
    {
      "say": "previous",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-M",
        "shift",
        "-k",
        "Tab",
        "-m",
        "shift",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^(chromium|firefox|brave-browser|google-chrome)$"
      }
    },
    {
      "say": "tab close",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-k",
        "w",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^(chromium|firefox|brave-browser|google-chrome)$"
      }
    },
    {
      "say": "tab reopen",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-M",
        "shift",
        "-k",
        "t",
        "-m",
        "shift",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^(chromium|firefox|brave-browser|google-chrome)$"
      }
    },
    {
      "say": "next",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-k",
        "Right",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^spotify$"
      }
    },
    {
      "say": "previous",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-k",
        "Left",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^spotify$"
      }
    },
    {
      "say": "pause",
      "exec": [
        "wtype",
        "-k",
        "space"
      ],
      "when": {
        "activeClass": "^spotify$"
      }
    },
    {
      "say": "palette",
      "exec": [
        "wtype",
        "-M",
        "ctrl",
        "-k",
        "p",
        "-m",
        "ctrl"
      ],
      "when": {
        "activeClass": "^obsidian$"
      }
    }
  ]
}
